+/// Extra faces a host app injects (OneOffice's bundled CJK font). The first call wins.
+/// Empty unless [`set_host_fallback_fonts`] ran, so DeckCraft's own tests stay stable.
+static HOST_FONTS: OnceLock<Vec<(String, FontData)>> = OnceLock::new();
+
+/// Registers faces merged into every DeckCraft font chain. Call once, before the first frame
+/// that builds fonts. Each face is also placed first in the proportional and monospace families,
+/// which is what a host shell uses for its own chrome.
+pub fn set_host_fallback_fonts(fonts: Vec<(String, FontData)>) {
+    let _ = HOST_FONTS.set(fonts);
+}
+
+fn merge_host_fonts(defs: &mut FontDefinitions) {
+    let Some(host) = HOST_FONTS.get() else { return };
+    let mut keys = Vec::new();
+    for (key, data) in host {
+        defs.font_data.insert(key.clone(), Arc::new(data.clone()));
+        keys.push(key.clone());
+    }
+    for list in defs.families.values_mut() {
+        for key in &keys {
+            if !list.contains(key) {
+                list.push(key.clone());
+            }
+        }
+    }
+    for family in [FontFamily::Proportional, FontFamily::Monospace] {
+        if let Some(chain) = defs.families.get_mut(&family) {
+            for key in keys.iter().rev() {
+                chain.retain(|item| item != key);
+                chain.insert(0, key.clone());
+            }
+        }
+    }
+}
