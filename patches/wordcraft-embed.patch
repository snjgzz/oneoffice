+/// Extra faces a host app injects (OneOffice's bundled CJK font). The first call wins.
+/// Empty unless [`set_host_fallback_fonts`] ran, so WordCraft's own tests stay stable.
+static HOST_FONTS: OnceLock<Vec<(String, FontData)>> = OnceLock::new();
+
+/// Registers faces merged into every WordCraft font chain. Call once, before the first frame
+/// that builds fonts. Each face is also placed first in the proportional and monospace families,
+/// which is what a host shell uses for its own chrome. Role chains keep the face at the end, so
+/// Latin interface fonts still win and the host face only fills glyphs they lack.
+pub fn set_host_fallback_fonts(fonts: Vec<(String, FontData)>) {
+    let _ = HOST_FONTS.set(fonts);
+}
+
+fn merge_host_fonts(fonts: &mut FontDefinitions) {
+    let Some(host) = HOST_FONTS.get() else { return };
+    let mut keys = Vec::new();
+    for (key, data) in host {
+        fonts.font_data.insert(key.clone(), Arc::new(data.clone()));
+        keys.push(key.clone());
+    }
+    for list in fonts.families.values_mut() {
+        for key in &keys {
+            if !list.contains(key) {
+                list.push(key.clone());
+            }
+        }
+    }
+    for family in [FontFamily::Proportional, FontFamily::Monospace] {
+        if let Some(chain) = fonts.families.get_mut(&family) {
+            for key in keys.iter().rev() {
+                chain.retain(|item| item != key);
+                chain.insert(0, key.clone());
+            }
+        }
+    }
+}
